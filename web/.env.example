# Base URL of the REST API (default: /api/v1 — served through the Vite dev proxy or nginx).
VITE_API_BASE_URL=/api/v1
# Dev-server only: where the Vite proxy forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Public origin used to build join/booking links shown to users (default: window.location.origin).
VITE_PUBLIC_APP_URL=
