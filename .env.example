# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
# Generate each secret with a cryptographically secure generator, e.g. in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# (or, where available:  openssl rand -base64 32)

# ---- Public URLs ---------------------------------------------------------------------------------
# Browser-facing origin of the web app (used in e-mail links, CORS and OAuth redirects)
APP_PUBLIC_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# WebSocket URL browsers use to reach LiveKit (wss://media.example.com in production)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Address LiveKit advertises for WebRTC media. 127.0.0.1 = same machine only.
# Use your LAN IP (e.g. 192.168.1.20) to test from a second device on the same network, and the server's public IP
# in production (or LIVEKIT_USE_EXTERNAL_IP=true to discover it via STUN). Media ports: UDP 50000-50100, TCP 7881.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=false
# UDP media port range (LiveKit config and published ports both follow it). On Windows PCs running Microsoft
# Teams, 50000-50059 is taken by Teams / reserved by Windows: use e.g. 51000-51100 there.
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50100
# Embedded TURN relay (UDP 3478) for users behind firewalls that block the media ports. Enable in production.
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=localhost
# MinIO only (--profile minio): browser-reachable endpoint for presigned URLs. Leave empty for AWS S3 and local storage.
S3_PUBLIC_ENDPOINT=
# MinIO's S3 port is bound to 127.0.0.1. Set 0.0.0.0 only if other devices must reach S3_PUBLIC_ENDPOINT directly
# (not needed with the "tls" profile, which serves S3 through Caddy).
S3_BIND_ADDRESS=127.0.0.1

# ---- HTTPS (docker compose --profile tls) --------------------------------------------------------
# Caddy terminates TLS for the web app, API and LiveKit on SITE_DOMAIN and for S3 on S3_DOMAIN.
# See infra/caddy/Caddyfile for the matching APP_PUBLIC_URL / LIVEKIT_PUBLIC_URL / S3_PUBLIC_ENDPOINT values.
SITE_DOMAIN=localhost
S3_DOMAIN=s3.localhost

# ---- Spring profile ------------------------------------------------------------------------------
# prod (default) forces Secure cookies, e-mail verification and S3 storage, and disables Swagger.
# For plain-http local development leave it empty (SPRING_PROFILES_ACTIVE=) so APP_COOKIE_SECURE and
# APP_OPENAPI_ENABLED below take effect.
SPRING_PROFILES_ACTIVE=

# ---- Secrets -------------------------------------------------------------------------------------
APP_JWT_SECRET=CHANGE_ME_at_least_32_bytes_of_random_data_here
POSTGRES_PASSWORD=CHANGE_ME
# pgAdmin web login (http://localhost:5050)
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
LIVEKIT_API_KEY=CHANGE_ME_key
LIVEKIT_API_SECRET=CHANGE_ME_at_least_32_characters_long_secret
# Only for MinIO or another S3-compatible server. Leave empty on AWS: the EC2 instance role is used.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: 32 random bytes, Base64 (openssl rand -base64 32). Required for Google/Microsoft calendar sync.
APP_CALENDAR_ENCRYPTION_KEY=
# Prometheus scrape credential for /actuator/prometheus (user "prometheus"). Empty = metrics endpoint closed.
APP_METRICS_SCRAPE_PASSWORD=CHANGE_ME_metrics

# ---- PostgreSQL and pgAdmin -----------------------------------------------------------------------
# Database name and owner. Only read when the pgdata volume is first created; changing them later does not rename an
# existing database. If you change them, also update docker/pgadmin/servers.json.
POSTGRES_DB=meet
POSTGRES_USER=meet
# Host port for PostgreSQL (bound to 127.0.0.1 only). Use e.g. 5433 if a PostgreSQL installed on Windows uses 5432.
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@domain.com
PGADMIN_PORT=5050

# ---- Storage on this machine -----------------------------------------------------------------------
# Folder for Redis, nightly database backups, MinIO (only with --profile minio) and speaking clips.
# Default ./docker (next to docker-compose.yml, git-ignored). Any absolute path also works, e.g. D:/meetly/docker or /srv/meetly.
DATA_ROOT=./docker

# ---- File storage: local disk or AWS S3 ------------------------------------------------------------
# Development: STORAGE_PROVIDER=local and SPRING_PROFILES_ACTIVE= (empty). No AWS account or MinIO needed.
#   Shared files and recordings go to STORAGE_LOCAL_BASE_PATH.
# Production on AWS: STORAGE_PROVIDER=s3, SPRING_PROFILES_ACTIVE=prod, AWS_REGION, AWS_S3_BUCKET, and an empty
#   S3_ENDPOINT= line. Give the EC2 instance an IAM role and keep every key in this file empty.
#   Leave S3_PUBLIC_ENDPOINT, S3_FILES_BUCKET, S3_RECORDINGS_BUCKET and RECORDING_STORAGE_TYPE empty.
#   The prod profile always uses S3. It refuses to start with local files or RECORDING_STORAGE_TYPE=LOCAL, and on AWS
#   the application refuses a public endpoint or a second bucket left over from development.
# MinIO (optional, development only): docker compose --profile minio up -d, STORAGE_PROVIDER=s3,
#   no S3_ENDPOINT line, S3_ACCESS_KEY / S3_SECRET_KEY set, S3_PUBLIC_ENDPOINT=http://localhost:9000,
#   RECORDING_STORAGE_TYPE=LOCAL (speaking clips only ever use AWS S3 or local disk).
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=./storage
# How long a signed download link stays valid (ISO-8601).
STORAGE_PRESIGN_TTL=PT15M
# One bucket for everything: AWS_S3_BUCKET below, with the prefixes files/, recordings/ and speaking-clips/.
# S3_FILES_BUCKET and S3_RECORDINGS_BUCKET are only for MinIO: on AWS they must be empty or equal AWS_S3_BUCKET.

# ---- Speaking-clip storage -----------------------------------------------------------------------
# LOCAL (Windows development): clips are saved in RECORDING_LOCAL_PATH as DD-MM-YYYY\<Meeting>\<Participant>\<file>.webm.
#   Docker mounts that folder into the API container; without Docker the "dev" profile uses it directly.
#   Empty RECORDING_LOCAL_PATH = DATA_ROOT/Recordings.
# S3 (production): clips are staged in that folder, then uploaded to the private bucket with the same layout.
#   Prefer an IAM role on the server and leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty.
# Empty RECORDING_STORAGE_TYPE follows STORAGE_PROVIDER. LOCAL is for development: the prod profile refuses it.
# Switching an existing installation from LOCAL to S3: copy the earlier clips once (same layout), e.g.
#   aws s3 sync <RECORDING_LOCAL_PATH> s3://<AWS_S3_BUCKET>/<AWS_S3_PREFIX> --exclude "*.part"
RECORDING_STORAGE_TYPE=
RECORDING_LOCAL_PATH=D:/MeetingApplication/Recordings
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=speaking-clips
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket for whole-meeting recordings (the egress worker writes here, the API reads from here). Empty = AWS_S3_BUCKET.
S3_RECORDINGS_BUCKET=

# ---- Behaviour -----------------------------------------------------------------------------------
# false is convenient for local development; keep true in production
APP_REQUIRE_EMAIL_VERIFICATION=true
# Secure cookies require HTTPS. Set false only for plain-http local development (ignored by the prod profile).
APP_COOKIE_SECURE=false
# Swagger UI at /swagger-ui.html. Keep false outside development (ignored by the prod profile).
APP_OPENAPI_ENABLED=false
# Whole-meeting recordings: off until a recorder exists. Keep false on a small server (see docs/07-deployment.md).
APP_CLOUD_RECORDING_ENABLED=false
# Days a whole-meeting recording is kept. Separate from speaking clips, and shared files are never removed by age.
APP_RECORDING_RETENTION_DAYS=90
# Days a speaking clip is kept in S3 before it is deleted (the S3 lifecycle rule must match). Local clips are never removed.
APP_SPEECH_CLIP_RETENTION_DAYS=90
# Sender address. Gmail needs this to be the SMTP account or one of its verified aliases.
APP_MAIL_FROM=CHANGE_ME_sender_address

# ---- SMTP: real mail in every environment, local and production. All four CHANGE_ME values are required. -----
# Gmail: use an app password (Google account > Security > App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# ---- Optional integrations -----------------------------------------------------------------------
# Social sign-in (activate with SPRING_PROFILES_ACTIVE=oauth, see backend/src/main/resources/application-oauth.yml)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Calendar sync (redirect URI to register: <APP_CALENDAR_CALLBACK_BASE_URL>/api/v1/calendar/oauth/callback)
APP_CALENDAR_CALLBACK_BASE_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# Tracing (the "observability" compose profile runs Jaeger)
OTEL_SAMPLING_PROBABILITY=1.0
